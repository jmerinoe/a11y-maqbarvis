# Copy to .env.development (local dev) or configure in CI for production.
# Base URL of the shared ranking API (Azure Function App).
# Leave empty to run fully local (offline mode, no server calls).
VITE_API_BASE_URL=http://localhost:7071
# Shared event key baked into the bundle — must match EVENT_KEY in the
# Function App settings. Protects against casual submissions only.
VITE_EVENT_KEY=
